# Supabase (required for production — omit to run DEMO mode locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# When true, or when Supabase URL is empty, the app uses in-memory DEMO seed data.
LAUNCHGATE_DEMO_MODE=true

# Vercel sets this automatically
VERCEL_URL=
